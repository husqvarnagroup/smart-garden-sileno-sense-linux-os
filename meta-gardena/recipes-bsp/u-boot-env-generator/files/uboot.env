arch=arm
baudrate=115200
board=p3450-0000
board_name=p3450-0000
boot_dcache_off=dcache off
boot_prefixes=/ /boot/
boot_syslinux_conf=extlinux/extlinux.conf
boot_targets=mmc0
bootdelay=2
bootcount=0
bootlimit=2
cbootargs=tegraid=21.1.2.0.0 ddr_die=4096M@2048M section=512M memtype=0 vpr_resize usb_port_owner_info=0 lane_owner_info=0 emc_max_dvfs=0 touch_id=0@63 video=tegrafb no_console_suspend=1 console=ttyS0,115200n8 debug_uartport=lsport,4 earlyprintk=uart8250-32bit,0x70006000 maxcpus=4 usbcore.old_scheme_first=1 lp0_vec=0x1000@0xff780000 core_edp_mv=1125 core_edp_ma=4000 gpt  console=ttyS0,115200 console=tty0 fbcon=map:0 net.ifnames=0 sdhci_tegra.en_boot_part_access=1
cpu=armv8
fdt_addr=83100000
fdt_addr_r=0x83000000
fdt_copy_node_paths=/chosen/plugin-manager:/chosen/reset:/chosen/display-board:/chosen/proc-board:/chosen/pmu-board:/external-memory-controller@7001b000:/memory@80000000
fdt_copy_prop_paths=/bpmp/carveout-start:/bpmp/carveout-size:/chosen/eks_info:/chosen/nvidia,bluetooth-mac:/chosen/nvidia,ethernet-mac:/chosen/nvidia,wifi-mac:/chosen/uuid:/chosen/linux,initrd-start:/chosen/linux,initrd-end:/serial-number:/psci/nvidia,system-lp0-disable
fdt_high=ffffffffffffffff
fdtcontroladdr=fc5faec0
fdtfile=nvidia/tegra210-p3450-0000.dtb
fdtoverlay_addr_r=0x90200000
initrd_high=ffffffffffffffff
kernel_addr_r=0x84000000
loadaddr=0x84000000
ramdisk_addr_r=0x87200000
bootscript_addr_r=0x88000000
mmcpartition=4
scriptaddr=0x90000000
soc=tegra210
stderr=serial
stdin=serial
stdout=serial
vendor=nvidia
read_boot_part_number=part number mmc 0 BOOT-DATA boot_part_number
load_boot_script_cmd=load mmc 0:${boot_part_number} ${bootscript_addr_r} /boot.scr
bootcmd_script=run read_boot_part_number; run load_boot_script_cmd; source ${bootscript_addr_r}
bootcmd_mmc=sysboot mmc 0:1 any 0x90000000 /boot/extlinux/extlinux.conf
bootcmd=fallback=0; run bootcmd_script; run bootcmd_mmc
altbootcmd=fallback=1; run bootcmd_script; run bootcmd_mmc
