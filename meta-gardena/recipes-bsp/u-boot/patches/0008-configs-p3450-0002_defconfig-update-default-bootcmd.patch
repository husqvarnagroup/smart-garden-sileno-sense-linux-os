From e3bca4915ed00f489929dc900e5aa74a1e8abc2d Mon Sep 17 00:00:00 2001
From: Erik Stromdahl <erik.a.stromdahl@husqvarnagroup.com>
Date: Fri, 7 Nov 2025 14:31:57 +0100
Subject: [PATCH] configs/p3450-0002_defconfig: update default bootcmd

Signed-off-by: Erik Stromdahl <erik.a.stromdahl@husqvarnagroup.com>
---
 configs/p3450-0002_defconfig | 1 +
 1 file changed, 1 insertion(+)

diff --git a/configs/p3450-0002_defconfig b/configs/p3450-0002_defconfig
index f6386b0629..f84f794c0c 100644
--- a/configs/p3450-0002_defconfig
+++ b/configs/p3450-0002_defconfig
@@ -13,6 +13,7 @@ CONFIG_SYS_LOAD_ADDR=0x84000000
 CONFIG_FIT=y
 CONFIG_OF_BOARD_SETUP=y
 CONFIG_OF_SYSTEM_SETUP=y
+CONFIG_BOOTCOMMAND="sysboot mmc 0:1 any 0x90000000 /boot/extlinux/extlinux.conf"
 CONFIG_CONSOLE_MUX=y
 CONFIG_SYS_STDIO_DEREGISTER=y
 CONFIG_SYS_PROMPT="Tegra210 (P3450-0002) # "
