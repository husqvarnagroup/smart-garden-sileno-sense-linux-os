From 7647e13a09cc3d1ba9a2de97f23b3b55e5b9d529 Mon Sep 17 00:00:00 2001
From: Erik Stromdahl <erik.a.stromdahl@husqvarnagroup.com>
Date: Wed, 19 Nov 2025 07:03:50 +0100
Subject: [PATCH] configs/p3450-0002_defconfig: move env to mmc

Signed-off-by: Erik Stromdahl <erik.a.stromdahl@husqvarnagroup.com>
---
 configs/p3450-0002_defconfig | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/configs/p3450-0002_defconfig b/configs/p3450-0002_defconfig
index 70c9f7e478..f713d351d2 100644
--- a/configs/p3450-0002_defconfig
+++ b/configs/p3450-0002_defconfig
@@ -3,9 +3,11 @@ CONFIG_ARCH_TEGRA=y
 CONFIG_SYS_TEXT_BASE=0x80080000
 CONFIG_SYS_MALLOC_LEN=0x2500000
 CONFIG_NR_DRAM_BANKS=16
-CONFIG_ENV_SIZE=0x30000
+CONFIG_ENV_SIZE=0x8000
+CONFIG_ENV_OFFSET=0x3D0000
 CONFIG_DEFAULT_DEVICE_TREE="tegra210-p3450-0000"
 CONFIG_BOOTCOUNT_BOOTLIMIT=2
+CONFIG_ENV_OFFSET_REDUND=0x3D8000
 CONFIG_TEGRA210=y
 CONFIG_TARGET_P3450_0000=y
 CONFIG_P3450_EMMC=y
@@ -34,10 +36,8 @@ CONFIG_CMD_EXT4_WRITE=y
 CONFIG_CMD_SQUASHFS=y
 CONFIG_OF_LIVE=y
 CONFIG_ENV_OVERWRITE=y
-CONFIG_ENV_IS_IN_FAT=y
-# CONFIG_ENV_IS_IN_MMC is not set
 CONFIG_SYS_REDUNDAND_ENVIRONMENT=y
-CONFIG_ENV_FAT_DEVICE_AND_PART="0:3"
+CONFIG_SYS_MMC_ENV_PART=2
 CONFIG_BOOTCOUNT_LIMIT=y
 CONFIG_BOOTCOUNT_ENV=y
 CONFIG_DFU_MMC=y
-- 
2.43.0

