From ef9480a27b812e4e5cba7ce437508253ec005132 Mon Sep 17 00:00:00 2001
From: Reto Schneider <reto.schneider@husqvarnagroup.com>
Date: Mon, 8 Jun 2026 11:29:30 +0200
Subject: [PATCH] nvidia: Add IMX675

---
 nvidia/drivers/media/i2c/Kconfig              |  11 +
 nvidia/drivers/media/i2c/Makefile             |   1 +
 nvidia/drivers/media/i2c/imx219.c             |  85 +-
 nvidia/drivers/media/i2c/imx219_mode_tbls.h   |  50 +
 nvidia/drivers/media/i2c/imx675.c             | 945 ++++++++++++++++++
 nvidia/drivers/media/i2c/imx675_mode_tbls.h   | 275 +++++
 .../platform/tegra/camera/sensor_common.c     |  32 +
 .../platform/tegra/camera/tegracam_ctrls.c    |  40 +
 nvidia/include/media/camera_common.h          |   3 +
 nvidia/include/media/imx675.h                 |  17 +
 nvidia/include/media/tegra-v4l2-camera.h      |   5 +
 nvidia/platform/t210/porg/kernel-dts/Makefile |   1 +
 .../tegra210-camera-rbpcv2-imx219.dtsi        |  40 +-
 .../tegra210-camera-sunny-imx675.dtsi         | 347 +++++++
 .../tegra210-porg-camera-sunny-imx675.dtsi    |  44 +
 .../tegra210-p3448-0002-p3449-0000-b00.dts    |   6 +-
 .../tegra210-p3448-common-imx675.dts          | 122 +++
 17 files changed, 2013 insertions(+), 11 deletions(-)
 create mode 100644 nvidia/drivers/media/i2c/imx675.c
 create mode 100644 nvidia/drivers/media/i2c/imx675_mode_tbls.h
 create mode 100644 nvidia/include/media/imx675.h
 create mode 100644 nvidia/platform/t210/porg/kernel-dts/porg-platforms/tegra210-camera-sunny-imx675.dtsi
 create mode 100644 nvidia/platform/t210/porg/kernel-dts/porg-platforms/tegra210-porg-camera-sunny-imx675.dtsi
 create mode 100644 nvidia/platform/t210/porg/kernel-dts/tegra210-p3448-common-imx675.dts

diff --git a/nvidia/drivers/media/i2c/Kconfig b/nvidia/drivers/media/i2c/Kconfig
index 326dbb096017..085fe2a4a78c 100644
--- a/nvidia/drivers/media/i2c/Kconfig
+++ b/nvidia/drivers/media/i2c/Kconfig
@@ -165,6 +165,17 @@ config VIDEO_IMX390
 	  To compile this driver as a module, choose M here: the module
 	  will be called imx390.
 
+config VIDEO_IMX675
+	tristate "Sony IMX675 sensor support"
+	depends on OF_GPIO
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the Sony
+	  IMX675 camera.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called imx675.
+
 endmenu
 
 endif
diff --git a/nvidia/drivers/media/i2c/Makefile b/nvidia/drivers/media/i2c/Makefile
index c6d34e8077e3..8445ef94b3d0 100644
--- a/nvidia/drivers/media/i2c/Makefile
+++ b/nvidia/drivers/media/i2c/Makefile
@@ -21,3 +21,4 @@ obj-$(CONFIG_VIDEO_LT6911UXC) +=lt6911uxc.o
 obj-$(CONFIG_I2C_IOEXPANDER_SER_MAX9295) += max9295.o
 obj-$(CONFIG_I2C_IOEXPANDER_DESER_MAX9296) += max9296.o
 obj-$(CONFIG_VIDEO_IMX390) += imx390.o
+obj-$(CONFIG_VIDEO_IMX675) += imx675.o
diff --git a/nvidia/drivers/media/i2c/imx219.c b/nvidia/drivers/media/i2c/imx219.c
index 1772af187b8f..e577bbd2a615 100644
--- a/nvidia/drivers/media/i2c/imx219.c
+++ b/nvidia/drivers/media/i2c/imx219.c
@@ -43,7 +43,9 @@
 /* imx219 sensor register address */
 #define IMX219_MODEL_ID_ADDR_MSB		0x0000
 #define IMX219_MODEL_ID_ADDR_LSB		0x0001
-#define IMX219_GAIN_ADDR			0x0157
+#define IMX219_GAIN_ADDR			    0x0157
+#define IMX219_DIGITAL_GAIN_ADDR_MSB    0x0158
+#define IMX219_DIGITAL_GAIN_ADDR_LSB    0x0159
 #define IMX219_FRAME_LENGTH_ADDR_MSB		0x0160
 #define IMX219_FRAME_LENGTH_ADDR_LSB		0x0161
 #define IMX219_COARSE_INTEG_TIME_ADDR_MSB	0x015a
@@ -62,6 +64,7 @@ static const u32 ctrl_cid_list[] = {
 	TEGRA_CAMERA_CID_EXPOSURE,
 	TEGRA_CAMERA_CID_FRAME_RATE,
 	TEGRA_CAMERA_CID_SENSOR_MODE_ID,
+	TEGRA_CAMERA_CID_DIGITAL_GAIN,
 };
 
 struct imx219 {
@@ -104,6 +107,14 @@ static inline void imx219_get_gain_reg(imx219_reg *reg, u8 gain)
 	reg->val = gain & 0xff;
 }
 
+static inline void imx219_get_digital_gain_regs(imx219_reg *regs, u16 digital_gain)
+{
+	regs->addr = IMX219_DIGITAL_GAIN_ADDR_MSB;
+	regs->val = (digital_gain >> 8) & 0xff;
+	(regs + 1)->addr = IMX219_DIGITAL_GAIN_ADDR_LSB;
+	(regs + 1)->val = (digital_gain) & 0xff;
+}
+
 static inline int imx219_read_reg(struct camera_common_data *s_data,
 	u16 addr, u8 *val)
 {
@@ -135,6 +146,50 @@ static int imx219_write_table(struct imx219 *priv, const imx219_reg table[])
 		IMX219_TABLE_WAIT_MS, IMX219_TABLE_END);
 }
 
+static int imx219_write_table_from_file(struct imx219 *priv)
+{
+    struct file *fp;
+    char str[32];
+    int rdlen = 1;
+    int addr = 0;
+    int val = 0;
+    imx219_reg* table;
+    int idx = 0;
+    int ret = 0;
+    loff_t file_offset = 0;
+
+    fp = filp_open("/home/toadi/data/imx219.cfg", O_RDONLY, 0);
+    if (IS_ERR(fp)) {
+        dev_dbg(priv->s_data->dev, "%s: cannot open /home/toadi/data/imx219.cfg\n",
+                __func__);
+        return ret;
+	}
+
+    table = kmalloc(1024 * sizeof(imx219_reg),
+                            GFP_KERNEL);
+    table[idx].addr = IMX219_TABLE_END;
+    table[idx].val = 0;
+
+    while(rdlen > 0) {
+        memset(str, 0, sizeof(str));
+        rdlen = kernel_read(fp, file_offset, str, 8);
+
+        if (rdlen > 0) {
+            sscanf(str, "%x:%x",
+		        &addr, &val);
+
+            table[idx].addr = addr;
+            table[idx].val = val;
+            ++idx;
+            file_offset += rdlen;
+        }
+    }
+
+    ret = imx219_write_table(priv, table);
+    kfree(table);
+    return ret;
+}
+
 static int imx219_set_group_hold(struct tegracam_device *tc_dev, bool val)
 {
 	/* imx219 does not support group hold */
@@ -199,6 +254,32 @@ static int imx219_set_gain(struct tegracam_device *tc_dev, s64 val)
 	return 0;
 }
 
+static int imx219_set_digital_gain(struct tegracam_device *tc_dev, s64 val)
+{
+	struct camera_common_data *s_data = tc_dev->s_data;
+	struct device *dev = s_data->dev;
+	const struct sensor_mode_properties *mode =
+		&s_data->sensor_props.sensor_modes[s_data->mode_prop_idx];
+
+	int err = 0;
+	imx219_reg digital_gain_regs;
+	s16 digital_gain;
+
+	if (val < mode->control_properties.min_digital_gain_val)
+		val = mode->control_properties.min_digital_gain_val;
+	else if (val > mode->control_properties.max_digital_gain_val)
+		val = mode->control_properties.max_digital_gain_val;
+
+    digital_gain = val;
+
+	imx219_get_digital_gain_regs(&digital_gain_regs, digital_gain);
+	err = imx219_write_reg(s_data, digital_gain_regs.addr, digital_gain_regs.val);
+	if (err)
+		dev_dbg(dev, "%s: digital_gain control error\n", __func__);
+
+	return 0;
+}
+
 static int imx219_set_frame_rate(struct tegracam_device *tc_dev, s64 val)
 {
 	struct camera_common_data *s_data = tc_dev->s_data;
@@ -295,6 +376,7 @@ static struct tegracam_ctrl_ops imx219_ctrl_ops = {
 	.set_exposure = imx219_set_exposure,
 	.set_frame_rate = imx219_set_frame_rate,
 	.set_group_hold = imx219_set_group_hold,
+    .set_digital_gain = imx219_set_digital_gain,
 };
 
 static int imx219_power_on(struct camera_common_data *s_data)
@@ -586,6 +668,7 @@ static int imx219_start_streaming(struct tegracam_device *tc_dev)
 {
 	struct imx219 *priv = (struct imx219 *)tegracam_get_privdata(tc_dev);
 
+    imx219_write_table_from_file(priv);
 	return imx219_write_table(priv, mode_table[IMX219_START_STREAM]);
 }
 
diff --git a/nvidia/drivers/media/i2c/imx219_mode_tbls.h b/nvidia/drivers/media/i2c/imx219_mode_tbls.h
index ae1b12713110..8c80e5071ba1 100644
--- a/nvidia/drivers/media/i2c/imx219_mode_tbls.h
+++ b/nvidia/drivers/media/i2c/imx219_mode_tbls.h
@@ -332,12 +332,56 @@ static imx219_reg imx219_mode_1280x720_120fps[] = {
 	{IMX219_TABLE_END, 0x00}
 };
 */
+
+static imx219_reg imx219_mode_1640x1232_25fps[] = {
+	/* capture settings */
+	{0x0157, 0x00}, /* ANALOG_GAIN_GLOBAL[7:0] */
+	{0x015A, 0x09}, /* COARSE_INTEG_TIME[15:8] */
+	{0x015B, 0xbd}, /* COARSE_INTEG_TIME[7:0] */
+	/* format settings */
+	{0x0160, 0x09}, /* FRM_LENGTH[15:8] */
+	{0x0161, 0xC1}, /* FRM_LENGTH[7:0] */
+	{0x0162, 0x0D}, /* LINE_LENGTH[15:8] */
+	{0x0163, 0x78}, /* LINE_LENGTH[7:0] */
+	{0x0164, 0x00},
+	{0x0165, 0x00},
+	{0x0166, 0x0C},
+	{0x0167, 0xCF},
+	{0x0168, 0x00},
+	{0x0169, 0x00},
+	{0x016A, 0x09},
+	{0x016B, 0xA0},
+	{0x016C, 0x06},
+	{0x016D, 0x68},
+	{0x016E, 0x04},
+	{0x016F, 0xD0},
+	{0x0170, 0x01},
+	{0x0171, 0x01},
+	{0x0174, 0x01},
+	{0x0175, 0x01},
+	{0x018C, 0x0A},
+	{0x018D, 0x0A},
+	/* clock dividers */
+	{0x0301, 0x05},
+	{0x0303, 0x01},
+	{0x0304, 0x03},
+	{0x0305, 0x03},
+	{0x0306, 0x00},
+	{0x0307, 0x39},
+	{0x0309, 0x0A},
+	{0x030B, 0x01},
+	{0x030C, 0x00},
+	{0x030D, 0x72},
+	{IMX219_TABLE_END, 0x00}
+};
+
 enum {
 	IMX219_MODE_3264x2464_21FPS,
 	IMX219_MODE_3264x1848_28FPS,
 	IMX219_MODE_1920x1080_30FPS,
 	IMX219_MODE_1640x1232_30FPS,
 	IMX219_MODE_1280x720_60FPS,
+    IMX219_MODE_1640x1232_25FPS,
 
 	IMX219_MODE_COMMON,
 	IMX219_START_STREAM,
@@ -350,6 +394,7 @@ static imx219_reg *mode_table[] = {
 	[IMX219_MODE_1920x1080_30FPS] = imx219_mode_1920x1080_30fps,
 	[IMX219_MODE_1640x1232_30FPS] = imx219_mode_1640x1232_30fps,
 	[IMX219_MODE_1280x720_60FPS] = imx219_mode_1280x720_60fps,
+	[IMX219_MODE_1640x1232_25FPS] = imx219_mode_1640x1232_25fps,
 
 	[IMX219_MODE_COMMON]  = imx219_mode_common,
 	[IMX219_START_STREAM]  = imx219_start_stream,
@@ -360,6 +405,10 @@ static const int imx219_21fps[] = {
 	21,
 };
 
+static const int imx219_25fps[] = {
+	25,
+};
+
 static const int imx219_28fps[] = {
 	28,
 };
@@ -383,6 +432,7 @@ static const struct camera_common_frmfmt imx219_frmfmt[] = {
 	{{1920, 1080},	imx219_30fps, 1, 0, IMX219_MODE_1920x1080_30FPS},
 	{{1640, 1232},	imx219_30fps, 1, 0, IMX219_MODE_1640x1232_30FPS},
 	{{1280, 720},	imx219_60fps, 1, 0, IMX219_MODE_1280x720_60FPS},
+	{{1640, 1232},	imx219_25fps, 1, 0, IMX219_MODE_1640x1232_25FPS},
 };
 
 #endif /* __IMX219_I2C_TABLES__ */
diff --git a/nvidia/drivers/media/i2c/imx675.c b/nvidia/drivers/media/i2c/imx675.c
new file mode 100644
index 000000000000..d7caa40c0f09
--- /dev/null
+++ b/nvidia/drivers/media/i2c/imx675.c
@@ -0,0 +1,945 @@
+#include <linux/gpio.h>
+#include <linux/of_device.h>
+#include <linux/of_gpio.h>
+
+#include <media/tegra_v4l2_camera.h>
+#include <media/tegracam_core.h>
+#include <media/tegracam_utils.h>
+#include <media/imx675.h>
+#include <soc/tegra/chip-id.h>
+
+#include "imx675_mode_tbls.h"
+
+/* imx675 - sensor parameter limits */
+#define IMX675_MIN_GAIN 0x0000
+#define IMX675_MAX_GAIN 0x00f0
+#define IMX675_MIN_FRAME_LINE_LENGTH 2200
+#define IMX675_MAX_FRAME_LINE_LENGTH 27500
+#define IMX675_MIN_SHUTTER_SWEEP_TIME 0x0004
+
+#define IMX675_CLOCK_FREQUENCY 74250000
+
+/* imx675 sensor register address */
+#define IMX675_GROUP_HOLD_ADDR 0x3001
+#define IMX675_GAIN_ADDR_LSB 0x3070
+#define IMX675_CONVERSION_GAIN_ADDR 0x3030
+#define IMX675_FRAME_LINE_LENGTH_ADDR_LSB 0x3028
+#define IMX675_FRAME_LINE_LENGTH_ADDR_MSB 0x3029
+#define IMX675_SHUTTER_SWEEP_TIME_ADDR_LSB 0x3050
+#define IMX675_SHUTTER_SWEEP_TIME_ADDR_MSB 0x3051
+
+static const struct of_device_id imx675_of_match[] = {
+	{ .compatible = "nvidia,imx675", },
+	{ },
+};
+MODULE_DEVICE_TABLE(of, imx675_of_match);
+
+static const u32 ctrl_cid_list[] = {
+	TEGRA_CAMERA_CID_GAIN,
+	TEGRA_CAMERA_CID_EXPOSURE,
+	TEGRA_CAMERA_CID_FRAME_RATE,
+	TEGRA_CAMERA_CID_SENSOR_MODE_ID,
+};
+
+struct imx675 {
+	struct i2c_client *i2c_client;
+	struct v4l2_subdev *subdev;
+	u32 frame_line_length;
+	struct camera_common_data *s_data;
+	struct tegracam_device *tc_dev;
+};
+
+static const struct regmap_config sensor_regmap_config = {
+	.reg_bits = 16,
+	.val_bits = 8,
+	.cache_type = REGCACHE_RBTREE,
+	.use_single_rw = true,
+};
+
+static inline void imx675_get_frame_line_length_regs(imx675_reg *regs, u32 frame_line_length)
+{
+	regs->addr = IMX675_FRAME_LINE_LENGTH_ADDR_LSB;
+	regs->val = (frame_line_length) & 0xff;
+	(regs + 1)->addr = IMX675_FRAME_LINE_LENGTH_ADDR_MSB;
+	(regs + 1)->val = (frame_line_length >> 8) & 0xff;
+}
+
+static inline void imx675_get_shutter_sweep_time_regs(imx675_reg *regs, u32 shutter_sweep_time)
+{
+	regs->addr = IMX675_SHUTTER_SWEEP_TIME_ADDR_LSB;
+	regs->val = shutter_sweep_time & 0xff;
+	(regs + 1)->addr = IMX675_SHUTTER_SWEEP_TIME_ADDR_MSB;
+	(regs + 1)->val = (shutter_sweep_time >> 8) & 0x0f;
+}
+
+static inline void imx675_get_gain_regs(imx675_reg *regs, u8 gain, u8 gain_mode)
+{
+	regs->addr = IMX675_CONVERSION_GAIN_ADDR;
+	regs->val = gain_mode;
+	(regs + 1)->addr = IMX675_GAIN_ADDR_LSB;
+	(regs + 1)->val = gain;
+}
+
+static inline void imx675_get_group_hold_reg(imx675_reg *reg, bool val)
+{
+	reg->addr = IMX675_GROUP_HOLD_ADDR;
+	reg->val = val ? 1 : 0;
+}
+
+static inline int imx675_read_reg(struct camera_common_data *s_data, u16 addr, u8 *val)
+{
+	int err = 0;
+	u32 reg_val = 0;
+
+	err = regmap_read(s_data->regmap, addr, &reg_val);
+	*val = reg_val & 0xff;
+
+	return err;
+}
+
+static inline int imx675_write_reg(struct camera_common_data *s_data, u16 addr, u8 val)
+{
+	int err = 0;
+
+	err = regmap_write(s_data->regmap, addr, val);
+	if (err)
+		dev_err(s_data->dev, "%s: i2c write failed, 0x%x = %x", __func__, addr, val);
+
+	return err;
+}
+
+static int imx675_write_table(struct imx675 *priv, const imx675_reg table[])
+{
+	return regmap_util_write_table_8(priv->s_data->regmap, table, NULL, 0,
+		IMX675_TABLE_WAIT_MS, IMX675_TABLE_END);
+}
+
+static int imx675_set_group_hold(struct tegracam_device *tc_dev, bool val)
+{
+	struct camera_common_data *s_data = tc_dev->s_data;
+	struct device *dev = s_data->dev;
+
+	int err = 0;
+	imx675_reg gh_reg;
+
+	dev_dbg(dev, "%s: val: %d\n", __func__, val);
+
+	imx675_get_group_hold_reg(&gh_reg, val);
+	err = imx675_write_reg(s_data, gh_reg.addr, gh_reg.val);
+	if (err)
+		dev_err(dev, "%s: group hold control error\n", __func__);
+
+	return 0;
+
+}
+
+static int imx675_set_gain(struct tegracam_device *tc_dev, s64 val)
+{
+	struct camera_common_data *s_data = tc_dev->s_data;
+	struct device *dev = s_data->dev;
+	const struct sensor_mode_properties *mode = &s_data->sensor_props.sensor_modes[s_data->mode_prop_idx];
+
+	int err = 0;
+	imx675_reg gain_regs[2];
+	s16 gain;
+	u8 gain_mode;
+	int i;
+
+	if(mode->control_properties.gain_factor > 0)
+		gain = (val & 0xFF) / mode->control_properties.gain_factor;
+	gain_mode = (val >> 8) & 0x1;
+
+	if (gain < IMX675_MIN_GAIN)
+		gain = IMX675_MIN_GAIN;
+	else if (gain > IMX675_MAX_GAIN)
+		gain = IMX675_MAX_GAIN;
+
+	dev_dbg(dev, "%s: val: %lld (/%d) [times], gain: %u\n", __func__, val, mode->control_properties.gain_factor, gain);
+
+	imx675_get_gain_regs(gain_regs, (u8)gain, gain_mode);
+	for (i = 0; i < 2; i++) {
+		err = imx675_write_reg(s_data, gain_regs[i].addr, gain_regs[i].val);
+		if (err) {
+			dev_err(dev, "%s: gain control error\n", __func__);
+			return err;
+		}
+	}
+
+	return 0;
+}
+
+static int imx675_set_frame_rate(struct tegracam_device *tc_dev, s64 val)
+{
+	struct camera_common_data *s_data = tc_dev->s_data;
+	struct imx675 *priv = (struct imx675 *)tc_dev->priv;
+	struct device *dev = tc_dev->dev;
+	const struct sensor_mode_properties *mode = &s_data->sensor_props.sensor_modes[s_data->mode_prop_idx];
+
+	int err = 0;
+	imx675_reg fl_regs[2];
+	u32 frame_line_length = 0;
+	int i;
+
+	if(mode->image_properties.line_length > 0 && val > 0) {
+		frame_line_length = (u32)(IMX675_CLOCK_FREQUENCY *
+			(u64)mode->control_properties.framerate_factor /
+			mode->image_properties.line_length / val);
+	}
+
+	if (frame_line_length < IMX675_MIN_FRAME_LINE_LENGTH
+		|| frame_line_length > IMX675_MAX_FRAME_LINE_LENGTH)
+		return 0;
+
+	dev_dbg(dev, "%s: val: %llde-6 [fps], frame_line_length: %u\n", __func__, val, frame_line_length);
+
+	imx675_get_frame_line_length_regs(fl_regs, frame_line_length);
+	for (i = 0; i < 2; i++) {
+		err = imx675_write_reg(s_data, fl_regs[i].addr, fl_regs[i].val);
+		if (err) {
+			dev_err(dev, "%s: frame_line_length control error\n", __func__);
+			return err;
+		}
+	}
+
+	priv->frame_line_length = frame_line_length;
+
+	return 0;
+}
+
+static int imx675_set_exposure(struct tegracam_device *tc_dev, s64 val)
+{
+	struct camera_common_data *s_data = tc_dev->s_data;
+	struct imx675 *priv = (struct imx675 *)tc_dev->priv;
+	struct device *dev = tc_dev->dev;
+	const struct sensor_mode_properties *mode = &s_data->sensor_props.sensor_modes[s_data->mode_prop_idx];
+
+	int err = 0;
+	imx675_reg ct_regs[2];
+	const s32 max_shutter_sweep_time = priv->frame_line_length - 4;
+	u32 shutter_sweep_time;
+	int i;
+
+	/* translate value (from normalized exposure) */
+	val = val / mode->control_properties.exposure_factor;
+
+	if (val < IMX675_MIN_SHUTTER_SWEEP_TIME)
+		val = IMX675_MIN_SHUTTER_SWEEP_TIME;
+	else if (val > max_shutter_sweep_time) {
+		val = max_shutter_sweep_time;
+		dev_info(dev, "%s: exposure limited by frame_line_length: %d\n", __func__, max_shutter_sweep_time);
+	}
+
+	shutter_sweep_time = priv->frame_line_length - val;
+
+	dev_dbg(dev, "%s: val: %lld, shutter_sweep_time: %d\n", __func__, val, shutter_sweep_time);
+
+	imx675_get_shutter_sweep_time_regs(ct_regs, shutter_sweep_time);
+	for (i = 0; i < 2; i++) {
+		err = imx675_write_reg(s_data, ct_regs[i].addr, ct_regs[i].val);
+		if (err) {
+			dev_err(dev, "%s: shutter sweep time control error\n", __func__);
+			return err;
+		}
+	}
+
+	return 0;
+}
+
+static struct tegracam_ctrl_ops imx675_ctrl_ops = {
+	.numctrls = ARRAY_SIZE(ctrl_cid_list),
+	.ctrl_cid_list = ctrl_cid_list,
+	.set_gain = imx675_set_gain,
+	.set_exposure = imx675_set_exposure,
+	.set_frame_rate = imx675_set_frame_rate,
+	.set_group_hold = imx675_set_group_hold,
+};
+
+static int imx675_power_on(struct camera_common_data *s_data)
+{
+	int err = 0;
+	struct camera_common_power_rail *pw = s_data->power;
+	struct camera_common_pdata *pdata = s_data->pdata;
+	struct device *dev = s_data->dev;
+
+	dev_dbg(dev, "%s: power on\n", __func__);
+	if (pdata && pdata->power_on) {
+		err = pdata->power_on(pw);
+		if (err)
+			dev_err(dev, "%s failed.\n", __func__);
+		else
+			pw->state = SWITCH_ON;
+		return err;
+	}
+
+	if (pw->reset_gpio) {
+		if (gpio_cansleep(pw->reset_gpio))
+			gpio_set_value_cansleep(pw->reset_gpio, 0);
+		else
+			gpio_set_value(pw->reset_gpio, 0);
+	}
+
+	if (unlikely(!(pw->avdd || pw->iovdd || pw->dvdd)))
+		goto skip_power_seqn;
+
+	usleep_range(10, 20);
+
+	if (pw->avdd) {
+		err = regulator_enable(pw->avdd);
+		if (err)
+			goto imx675_avdd_fail;
+	}
+
+	if (pw->iovdd) {
+		err = regulator_enable(pw->iovdd);
+		if (err)
+			goto imx675_iovdd_fail;
+	}
+
+	if (pw->dvdd) {
+		err = regulator_enable(pw->dvdd);
+		if (err)
+			goto imx675_dvdd_fail;
+	}
+
+skip_power_seqn:
+	/* Tlow min 500ns */
+	usleep_range(10, 20);
+
+	if (pw->reset_gpio) {
+		if (gpio_cansleep(pw->reset_gpio))
+			gpio_set_value_cansleep(pw->reset_gpio, 1);
+		else
+			gpio_set_value(pw->reset_gpio, 1);
+	}
+
+	/* T3 min 1us */
+	usleep_range(10, 20);
+
+	pw->state = SWITCH_ON;
+
+	return 0;
+
+imx675_dvdd_fail:
+	regulator_disable(pw->iovdd);
+
+imx675_iovdd_fail:
+	regulator_disable(pw->avdd);
+
+imx675_avdd_fail:
+	dev_err(dev, "%s failed.\n", __func__);
+
+	return -ENODEV;
+}
+
+static int imx675_power_off(struct camera_common_data *s_data)
+{
+	int err = 0;
+	struct camera_common_power_rail *pw = s_data->power;
+	struct camera_common_pdata *pdata = s_data->pdata;
+	struct device *dev = s_data->dev;
+
+	dev_dbg(dev, "%s: power off\n", __func__);
+
+	if (pdata && pdata->power_off) {
+		err = pdata->power_off(pw);
+		if (err) {
+			dev_err(dev, "%s failed.\n", __func__);
+			return err;
+		}
+	} else {
+		if (pw->reset_gpio) {
+			if (gpio_cansleep(pw->reset_gpio))
+				gpio_set_value_cansleep(pw->reset_gpio, 0);
+			else
+				gpio_set_value(pw->reset_gpio, 0);
+		}
+
+		usleep_range(10, 10);
+
+		if (pw->dvdd)
+			regulator_disable(pw->dvdd);
+		if (pw->iovdd)
+			regulator_disable(pw->iovdd);
+		if (pw->avdd)
+			regulator_disable(pw->avdd);
+	}
+
+	pw->state = SWITCH_OFF;
+
+	return 0;
+}
+
+static int imx675_power_put(struct tegracam_device *tc_dev)
+{
+	struct camera_common_data *s_data = tc_dev->s_data;
+	struct camera_common_power_rail *pw = s_data->power;
+
+	if (unlikely(!pw))
+		return -EFAULT;
+
+	if (likely(pw->dvdd))
+		devm_regulator_put(pw->dvdd);
+
+	if (likely(pw->avdd))
+		devm_regulator_put(pw->avdd);
+
+	if (likely(pw->iovdd))
+		devm_regulator_put(pw->iovdd);
+
+	pw->dvdd = NULL;
+	pw->avdd = NULL;
+	pw->iovdd = NULL;
+
+	if (likely(pw->reset_gpio))
+		gpio_free(pw->reset_gpio);
+
+	return 0;
+}
+
+static int imx675_power_get(struct tegracam_device *tc_dev)
+{
+	struct device *dev = tc_dev->dev;
+	struct camera_common_data *s_data = tc_dev->s_data;
+	struct camera_common_power_rail *pw = s_data->power;
+	struct camera_common_pdata *pdata = s_data->pdata;
+	struct clk *parent;
+	int err = 0;
+
+	if (!pdata) {
+		dev_err(dev, "pdata missing\n");
+		return -EFAULT;
+	}
+
+	/* Sensor MCLK (aka. INCK) */
+	if (pdata->mclk_name) {
+		pw->mclk = devm_clk_get(dev, pdata->mclk_name);
+		if (IS_ERR(pw->mclk)) {
+			dev_err(dev, "unable to get clock %s\n", pdata->mclk_name);
+			return PTR_ERR(pw->mclk);
+		}
+
+		if (pdata->parentclk_name) {
+			parent = devm_clk_get(dev, pdata->parentclk_name);
+			if (IS_ERR(parent)) {
+				dev_err(dev, "unable to get parent clock %s", pdata->parentclk_name);
+			} else
+				clk_set_parent(pw->mclk, parent);
+		}
+	}
+
+	/* analog 2.8v */
+	if (pdata->regulators.avdd)
+		err |= camera_common_regulator_get(dev,
+				&pw->avdd, pdata->regulators.avdd);
+	/* IO 1.8v */
+	if (pdata->regulators.iovdd)
+		err |= camera_common_regulator_get(dev,
+				&pw->iovdd, pdata->regulators.iovdd);
+	/* dig 1.2v */
+	if (pdata->regulators.dvdd)
+		err |= camera_common_regulator_get(dev,
+				&pw->dvdd, pdata->regulators.dvdd);
+	if (err) {
+		dev_err(dev, "%s: unable to get regulator(s)\n", __func__);
+		goto done;
+	}
+
+	/* Reset or ENABLE GPIO */
+	pw->reset_gpio = pdata->reset_gpio;
+	err = gpio_request(pw->reset_gpio, "cam_reset_gpio");
+	if (err < 0) {
+		dev_err(dev, "%s: unable to request reset_gpio (%d)\n", __func__, err);
+		goto done;
+	}
+
+done:
+	pw->state = SWITCH_OFF;
+
+	return err;
+}
+
+static struct camera_common_pdata *imx675_parse_dt(
+	struct tegracam_device *tc_dev)
+{
+	struct device *dev = tc_dev->dev;
+	struct device_node *np = dev->of_node;
+	struct camera_common_pdata *board_priv_pdata;
+	const struct of_device_id *match;
+	struct camera_common_pdata *ret = NULL;
+	int err = 0;
+	int gpio;
+
+	if (!np)
+		return NULL;
+
+	match = of_match_device(imx675_of_match, dev);
+	if (!match) {
+		dev_err(dev, "Failed to find matching dt id\n");
+		return NULL;
+	}
+
+	board_priv_pdata = devm_kzalloc(dev,
+		sizeof(*board_priv_pdata), GFP_KERNEL);
+	if (!board_priv_pdata)
+		return NULL;
+
+	gpio = of_get_named_gpio(np, "reset-gpios", 0);
+	if (gpio < 0) {
+		if (gpio == -EPROBE_DEFER)
+			ret = ERR_PTR(-EPROBE_DEFER);
+		dev_err(dev, "reset-gpios not found\n");
+		goto error;
+	}
+	board_priv_pdata->reset_gpio = (unsigned int)gpio;
+
+	err = of_property_read_string(np, "mclk", &board_priv_pdata->mclk_name);
+	if (err)
+		dev_dbg(dev, "mclk name not present, "
+			"assume sensor driven externally\n");
+
+	err = of_property_read_string(np, "avdd-reg",
+		&board_priv_pdata->regulators.avdd);
+	err |= of_property_read_string(np, "iovdd-reg",
+		&board_priv_pdata->regulators.iovdd);
+	err |= of_property_read_string(np, "dvdd-reg",
+		&board_priv_pdata->regulators.dvdd);
+	if (err)
+		dev_dbg(dev, "avdd, iovdd and/or dvdd reglrs. not present, "
+			"assume sensor powered independently\n");
+
+	board_priv_pdata->has_eeprom =
+		of_property_read_bool(np, "has-eeprom");
+
+	return board_priv_pdata;
+
+error:
+	devm_kfree(dev, board_priv_pdata);
+
+	return ret;
+}
+
+static int imx675_set_mode(struct tegracam_device *tc_dev)
+{
+	struct imx675 *priv = (struct imx675 *)tegracam_get_privdata(tc_dev);
+	struct camera_common_data *s_data = tc_dev->s_data;
+
+	int err = 0;
+
+	err = imx675_write_table(priv, mode_table[IMX675_MODE_COMMON]);
+	if (err)
+		return err;
+
+	err = imx675_write_table(priv, mode_table[s_data->mode]);
+	if (err)
+		return err;
+
+	return 0;
+}
+
+static int imx675_start_streaming(struct tegracam_device *tc_dev)
+{
+	struct imx675 *priv = (struct imx675 *)tegracam_get_privdata(tc_dev);
+	struct camera_common_data *s_data = tc_dev->s_data;
+	struct device *dev = s_data->dev;
+	int err;
+
+	err = imx675_write_table(priv, mode_table[IMX675_START_STREAM]);
+	if (err) {
+		dev_err(dev, "%s: error writing table (%d)\n", __func__, err);
+	} else {
+		usleep_range(24000, 25000);
+	}
+
+	return err;
+}
+
+static int imx675_stop_streaming(struct tegracam_device *tc_dev)
+{
+	int err;
+	struct imx675 *priv = (struct imx675 *)tegracam_get_privdata(tc_dev);
+	struct camera_common_data *s_data = tc_dev->s_data;
+	struct device *dev = s_data->dev;
+
+	err = imx675_write_table(priv, mode_table[IMX675_STOP_STREAM]);
+	if (err)
+		dev_err(dev, "%s: error writing table (%d)\n", __func__, err);
+
+	usleep_range(50000, 51000);
+
+	return err;
+}
+
+static struct camera_common_sensor_ops imx675_common_ops = {
+	.numfrmfmts = ARRAY_SIZE(imx675_frmfmt),
+	.frmfmt_table = imx675_frmfmt,
+	.power_on = imx675_power_on,
+	.power_off = imx675_power_off,
+	.write_reg = imx675_write_reg,
+	.read_reg = imx675_read_reg,
+	.parse_dt = imx675_parse_dt,
+	.power_get = imx675_power_get,
+	.power_put = imx675_power_put,
+	.set_mode = imx675_set_mode,
+	.start_streaming = imx675_start_streaming,
+	.stop_streaming = imx675_stop_streaming,
+};
+
+static int imx675_board_setup(struct imx675 *priv)
+{
+	struct camera_common_data *s_data = priv->s_data;
+	struct camera_common_pdata *pdata = s_data->pdata;
+	struct device *dev = s_data->dev;
+	int err = 0;
+
+	err = imx675_power_on(s_data);
+	if (err) {
+		dev_err(dev, "error during power on sensor (%d)\n", err);
+		goto done;
+	}
+
+	if (pdata->mclk_name) {
+		err = camera_common_mclk_enable(s_data);
+		if (err) {
+			dev_err(dev, "error turning on mclk (%d)\n", err);
+		}
+
+		usleep_range(20, 30);
+	}
+
+done:
+	return err;
+}
+
+static int imx675_open(struct v4l2_subdev *sd, struct v4l2_subdev_fh *fh)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(sd);
+
+	dev_dbg(&client->dev, "%s:\n", __func__);
+
+	return 0;
+}
+
+static int imx675_s_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(sd);
+	struct camera_common_data *s_data = to_camera_common_data(&client->dev);
+	struct camera_common_sensor_ops *sensor_ops = s_data->ops;
+	struct tegracam_device *tc_dev = to_tegracam_device(s_data);
+	struct tegracam_sensor_data *sensor_data = &s_data->tegracam_ctrl_hdl->sensor_data;
+	struct sensor_blob *ctrl_blob = &sensor_data->ctrls_blob;
+	struct sensor_blob *mode_blob = &sensor_data->mode_blob;
+	int err = 0;
+
+	dev_dbg(&client->dev, "%s++ enable %d\n", __func__, enable);
+
+	/* reset control packet at start/stop streaming */
+	memset(ctrl_blob, 0, sizeof(struct sensor_blob));
+	memset(mode_blob, 0, sizeof(struct sensor_blob));
+	if (enable) {
+		/* increase ref count so module can't be unloaded while streaming */
+		if (!try_module_get(s_data->owner))
+			return -ENODEV;
+
+		err = sensor_ops->set_mode(tc_dev);
+		if (err) {
+			dev_err(&client->dev, "Error writing mode\n");
+			goto error;
+		}
+
+		/* update control ranges based on mode settings*/
+		err = tegracam_init_ctrl_ranges_by_mode(
+			s_data->tegracam_ctrl_hdl, (u32) s_data->mode);
+		if (err) {
+			dev_err(&client->dev, "Error updating control ranges\n");
+			goto error;
+		}
+
+		if (s_data->override_enable) {
+			err = tegracam_ctrl_set_overrides(s_data->tegracam_ctrl_hdl);
+			if (err) {
+				dev_err(&client->dev,
+					"overrides cannot be set\n");
+				goto error;
+			}
+		}
+
+		err = sensor_ops->start_streaming(tc_dev);
+		if (err) {
+			dev_err(&client->dev, "Error turning on streaming\n");
+			goto error;
+		}
+
+		/* add done command for blobs */
+		prepare_done_cmd(mode_blob);
+		prepare_done_cmd(ctrl_blob);
+		tc_dev->is_streaming = true;
+	} else {
+		err = sensor_ops->stop_streaming(tc_dev);
+		if (err) {
+			dev_err(&client->dev, "Error turning off streaming\n");
+			goto error;
+		}
+
+		/* add done command for blob */
+		prepare_done_cmd(ctrl_blob);
+		tc_dev->is_streaming = false;
+
+		module_put(s_data->owner);
+	}
+
+	return 0;
+
+error:
+	module_put(s_data->owner);
+	return err;
+}
+
+static int imx675_g_input_status(struct v4l2_subdev *sd, u32 *status)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(sd);
+	struct camera_common_data *s_data = to_camera_common_data(&client->dev);
+	struct camera_common_power_rail *pw = s_data->power;
+
+	*status = pw->state == SWITCH_ON;
+	return 0;
+}
+
+static int imx675_get_fmt(struct v4l2_subdev *sd, struct v4l2_subdev_pad_config *cfg, struct v4l2_subdev_format *format)
+{
+	return camera_common_g_fmt(sd, &format->format);
+}
+
+static int imx675_set_fmt(struct v4l2_subdev *sd, struct v4l2_subdev_pad_config *cfg, struct v4l2_subdev_format *format)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(sd);
+	struct camera_common_data *s_data = to_camera_common_data(&client->dev);
+	int ret;
+
+	if (format->which == V4L2_SUBDEV_FORMAT_TRY)
+		ret = camera_common_try_fmt(sd, &format->format);
+	else {
+		ret = camera_common_s_fmt(sd, &format->format);
+
+		if (ret == 0) {
+			/* update control ranges based on mode settings*/
+			ret = tegracam_init_ctrl_ranges_by_mode(s_data->tegracam_ctrl_hdl, (u32) s_data->mode);
+			if (ret) {
+				dev_err(&client->dev, "Error updating control ranges %d\n", ret);
+				return ret;
+			}
+		}
+	}
+
+	return ret;
+}
+
+int imx675_s_power(struct v4l2_subdev *sd, int on)
+{
+	int err = 0;
+	struct camera_common_data *s_data = to_camera_common_data(sd->dev);
+
+	dev_dbg(sd->dev, "%s: status %d\n", __func__, on);
+
+	if (on) {
+		if (s_data->ops && s_data->ops->power_on)
+			err = s_data->ops->power_on(s_data);
+		if (err) {
+			dev_err(s_data->dev,
+				"%s: error power on\n", __func__);
+			if (tegra_platform_is_silicon()) {
+				camera_common_dpd_enable(s_data);
+				camera_common_mclk_disable(s_data);
+			}
+		}
+
+		if (tegra_platform_is_silicon()) {
+			err = camera_common_mclk_enable(s_data);
+			if (err)
+				return err;
+
+			/* T4 min 20us */
+			usleep_range(20, 30);
+			camera_common_dpd_disable(s_data);
+		}
+	} else {
+		if (s_data->ops && s_data->ops->power_off)
+			err = s_data->ops->power_off(s_data);
+		if (tegra_platform_is_silicon()) {
+			camera_common_dpd_enable(s_data);
+			camera_common_mclk_disable(s_data);
+		}
+	}
+
+	return err;
+}
