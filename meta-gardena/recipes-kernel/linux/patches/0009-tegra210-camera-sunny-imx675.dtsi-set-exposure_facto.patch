@@ -183,7 +183,7 @@
 
 					gain_factor = "1";
 					framerate_factor = "1000000";
-					exposure_factor = "1";
+					exposure_factor = "1000000";
 					min_gain_val = "1"; /* 0dB */
 					max_gain_val = "240"; /* 72dB */
 					step_gain_val = "1"; /* 0.3dB */
@@ -227,7 +227,7 @@
 
 					gain_factor = "1";
 					framerate_factor = "1000000";
-					exposure_factor = "1";
+					exposure_factor = "1000000";
 					min_gain_val = "1"; /* 0dB */
